# ---------------------------------------------------------------------------
# Gemini (server-side)
# ---------------------------------------------------------------------------
# API key ฝั่งเซิร์ฟเวอร์ (ไม่บังคับ — ผู้ใช้ใส่คีย์ของตัวเองในหน้า ตั้งค่า ได้)
GEMINI_API_KEY=

# โมเดลหลักที่ใช้เรียก Gemini (ค่าเริ่มต้น: gemini-3.1-flash-lite)
# เปลี่ยนได้โดยไม่ต้องแก้โค้ด เช่น GEMINI_MODEL=gemini-4-hydrogen
GEMINI_MODEL=

# คำเตือน: VITE_* จะถูกฝังลงบันเดิลฝั่ง client — ใช้เฉพาะเครื่องพัฒนาเท่านั้น
VITE_GEMINI_API_KEY=

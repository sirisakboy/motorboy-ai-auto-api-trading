{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with synchronized settings and AI API key",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 320 },
        "geminiApiKey": { "type": "string", "maxLength": 256 },
        "watchlist": { "type": "array" },
        "priceAlerts": { "type": "array" },
        "useThb": { "type": "boolean" },
        "notificationsEnabled": { "type": "boolean" },
        "psychologySettings": { "type": "object" },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["userId", "updatedAt"]
    },
    "TradingHistoryItem": {
      "title": "TradingHistoryItem",
      "description": "History item for signals, AI analysis, or user alerts",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "type": { "type": "string", "maxLength": 40 },
        "symbol": { "type": "string", "maxLength": 32 },
        "action": { "type": "string", "maxLength": 40 },
        "price": { "type": "number" },
        "aiSummary": { "type": "string", "maxLength": 4000 },
        "confidence": { "type": "number" },
        "timestamp": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "userId", "symbol", "timestamp"]
    },
    "AssetCandleArchive": {
      "title": "AssetCandleArchive",
      "description": "Cached 1,000-day historical real OHLCV candle dataset per asset for low-bandwidth backtesting",
      "type": "object",
      "properties": {
        "assetId": { "type": "string", "maxLength": 64 },
        "userId": { "type": "string", "maxLength": 128 },
        "symbol": { "type": "string", "maxLength": 32 },
        "assetClass": { "type": "string", "maxLength": 32 },
        "source": { "type": "string", "maxLength": 40 },
        "candleCount": { "type": "integer" },
        "startDate": { "type": "string", "maxLength": 20 },
        "endDate": { "type": "string", "maxLength": 20 },
        "lastRotatedDateKey": { "type": "string", "maxLength": 20 },
        "candles": { "type": "array" },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["assetId", "userId", "symbol", "source", "candleCount", "candles", "updatedAt"]
    },
    "MarketArchiveSnapshot": {
      "title": "MarketArchiveSnapshot",
      "description": "Daily snapshot of market prices and per-asset news-volatility sensitivity",
      "type": "object",
      "properties": {
        "dateKey": { "type": "string", "maxLength": 20 },
        "userId": { "type": "string", "maxLength": 128 },
        "assetCount": { "type": "integer" },
        "newsCount": { "type": "integer" },
        "rotatedAssetSymbol": { "type": "string", "maxLength": 32 },
        "perAssetSummary": { "type": "array" },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["dateKey", "userId", "assetCount", "newsCount", "updatedAt"]
    },
    "BacktestArchiveRecord": {
      "title": "BacktestArchiveRecord",
      "description": "Backtest execution metrics paired with real-chart anomaly windows for news correlation lookup",
      "type": "object",
      "properties": {
        "archiveId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "assetSymbol": { "type": "string", "maxLength": 32 },
        "strategyId": { "type": "string", "maxLength": 64 },
        "timeframe": { "type": "string", "maxLength": 16 },
        "periodDays": { "type": "integer" },
        "historicalFeedSource": { "type": "string", "maxLength": 40 },
        "realCandleCount": { "type": "integer" },
        "anomalyCount": { "type": "integer" },
        "anomalyWindows": { "type": "array" },
        "recordedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["archiveId", "userId", "assetSymbol", "strategyId", "periodDays", "recordedAt"]
    },
    "AppSession": {
      "title": "AppSession",
      "description": "Read-only global session configuration",
      "type": "object",
      "properties": {
        "sessionId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 }
      },
      "required": ["sessionId"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Stores user settings, API key, watchlist, price alerts, and preferences"
    },
    "/users/{userId}/history/{historyId}": {
      "schema": "TradingHistoryItem",
      "description": "Stores user signal analysis and trading history entries"
    },
    "/users/{userId}/assetHistories/{assetId}": {
      "schema": "AssetCandleArchive",
      "description": "Stores 1,000-day historical candle caches per asset rotated daily"
    },
    "/users/{userId}/marketArchives/{dateKey}": {
      "schema": "MarketArchiveSnapshot",
      "description": "Stores daily market & news-sensitivity snapshots"
    },
    "/users/{userId}/backtestArchives/{archiveId}": {
      "schema": "BacktestArchiveRecord",
      "description": "Stores backtest summaries and real-chart anomaly windows"
    },
    "/sessions/{sessionId}": {
      "schema": "AppSession",
      "description": "Global read-only session data"
    }
  }
}

{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with synchronized settings and AI API key",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "email": { "type": "string" },
        "geminiApiKey": { "type": "string" },
        "watchlist": { "type": "array" },
        "useThb": { "type": "boolean" },
        "notificationsEnabled": { "type": "boolean" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId", "updatedAt"]
    },
    "TradingHistoryItem": {
      "title": "TradingHistoryItem",
      "description": "History item for signals, AI analysis, or user alerts",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "type": { "type": "string" },
        "symbol": { "type": "string" },
        "action": { "type": "string" },
        "price": { "type": "number" },
        "aiSummary": { "type": "string" },
        "confidence": { "type": "number" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "userId", "symbol", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Stores user settings, API key, and preferences"
    },
    "/users/{userId}/history/{historyId}": {
      "schema": "TradingHistoryItem",
      "description": "Stores user signal analysis and trading history entries"
    }
  }
}

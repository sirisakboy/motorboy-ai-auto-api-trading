rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default-Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Core Validation Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['userId', 'updatedAt'])
        && data.keys().hasOnly([
          'userId',
          'email',
          'geminiApiKey',
          'watchlist',
          'priceAlerts',
          'useThb',
          'notificationsEnabled',
          'psychologySettings',
          'updatedAt'
        ])
        && data.userId is string && data.userId == userId
        && data.updatedAt is string && data.updatedAt.size() <= 64
        && (!('email' in data) || (data.email is string && data.email.size() <= 320))
        && (!('geminiApiKey' in data) || (data.geminiApiKey is string && data.geminiApiKey.size() <= 256))
        && (!('watchlist' in data) || (data.watchlist is list && data.watchlist.size() <= 200))
        && (!('priceAlerts' in data) || (data.priceAlerts is list && data.priceAlerts.size() <= 100))
        && (!('useThb' in data) || data.useThb is bool)
        && (!('notificationsEnabled' in data) || data.notificationsEnabled is bool)
        && (!('psychologySettings' in data) || data.psychologySettings is map);
    }

    function isValidHistoryItem(data, userId, historyId) {
      return data.keys().hasAll(['id', 'userId', 'symbol', 'timestamp'])
        && data.keys().hasOnly(['id', 'userId', 'type', 'symbol', 'action', 'price', 'aiSummary', 'confidence', 'timestamp'])
        && data.id is string && data.id == historyId
        && data.userId is string && data.userId == userId
        && data.symbol is string && data.symbol.size() >= 1 && data.symbol.size() <= 32
        && data.timestamp is string && data.timestamp.size() <= 64
        && (!('type' in data) || (data.type is string && data.type.size() <= 40))
        && (!('action' in data) || (data.action is string && data.action.size() <= 40))
        && (!('price' in data) || data.price is number)
        && (!('aiSummary' in data) || (data.aiSummary is string && data.aiSummary.size() <= 4000))
        && (!('confidence' in data) || data.confidence is number);
    }

    function isValidAssetCandleArchive(data, userId, assetId) {
      return data.keys().hasAll(['assetId', 'userId', 'symbol', 'source', 'candleCount', 'candles', 'updatedAt'])
        && data.keys().hasOnly([
          'assetId',
          'userId',
          'symbol',
          'assetClass',
          'source',
          'candleCount',
          'startDate',
          'endDate',
          'lastRotatedDateKey',
          'candles',
          'updatedAt'
        ])
        && data.assetId is string && data.assetId == assetId
        && data.userId is string && data.userId == userId
        && data.symbol is string && data.symbol.size() >= 1 && data.symbol.size() <= 32
        && data.source is string && data.source.size() <= 40
        && data.candleCount is int && data.candleCount >= 0 && data.candleCount <= 1050
        && data.candles is list && data.candles.size() <= 1050
        && data.updatedAt is string && data.updatedAt.size() <= 64
        && (!('assetClass' in data) || (data.assetClass is string && data.assetClass.size() <= 32))
        && (!('startDate' in data) || (data.startDate is string && data.startDate.size() <= 20))
        && (!('endDate' in data) || (data.endDate is string && data.endDate.size() <= 20))
        && (!('lastRotatedDateKey' in data) || (data.lastRotatedDateKey is string && data.lastRotatedDateKey.size() <= 20));
    }

    function isValidMarketArchiveSnapshot(data, userId, dateKey) {
      return data.keys().hasAll(['dateKey', 'userId', 'assetCount', 'newsCount', 'updatedAt'])
        && data.keys().hasOnly(['dateKey', 'userId', 'assetCount', 'newsCount', 'rotatedAssetSymbol', 'perAssetSummary', 'updatedAt'])
        && data.dateKey is string && data.dateKey == dateKey && data.dateKey.size() <= 20
        && data.userId is string && data.userId == userId
        && data.assetCount is int && data.assetCount >= 0 && data.assetCount <= 200
        && data.newsCount is int && data.newsCount >= 0 && data.newsCount <= 500
        && data.updatedAt is string && data.updatedAt.size() <= 64
        && (!('rotatedAssetSymbol' in data) || (data.rotatedAssetSymbol is string && data.rotatedAssetSymbol.size() <= 32))
        && (!('perAssetSummary' in data) || (data.perAssetSummary is list && data.perAssetSummary.size() <= 60));
    }

    function isValidBacktestArchive(data, userId, archiveId) {
      return data.keys().hasAll(['archiveId', 'userId', 'assetSymbol', 'strategyId', 'periodDays', 'recordedAt'])
        && data.keys().hasOnly([
          'archiveId',
          'userId',
          'assetSymbol',
          'strategyId',
          'timeframe',
          'periodDays',
          'historicalFeedSource',
          'realCandleCount',
          'anomalyCount',
          'anomalyWindows',
          'recordedAt'
        ])
        && data.archiveId is string && data.archiveId == archiveId
        && data.userId is string && data.userId == userId
        && data.assetSymbol is string && data.assetSymbol.size() >= 1 && data.assetSymbol.size() <= 32
        && data.strategyId is string && data.strategyId.size() >= 1 && data.strategyId.size() <= 64
        && data.periodDays is int && data.periodDays >= 1 && data.periodDays <= 2000
        && data.recordedAt is string && data.recordedAt.size() <= 64
        && (!('timeframe' in data) || (data.timeframe is string && data.timeframe.size() <= 16))
        && (!('historicalFeedSource' in data) || (data.historicalFeedSource is string && data.historicalFeedSource.size() <= 40))
        && (!('realCandleCount' in data) || (data.realCandleCount is int && data.realCandleCount >= 0 && data.realCandleCount <= 2000))
        && (!('anomalyCount' in data) || (data.anomalyCount is int && data.anomalyCount >= 0 && data.anomalyCount <= 200))
        && (!('anomalyWindows' in data) || (data.anomalyWindows is list && data.anomalyWindows.size() <= 60));
    }

    // 2. Sessions (Read-Only)
    match /sessions/{sessionId} {
      allow get: if isSignedIn() && isValidId(sessionId);
      allow list, write: if false;
    }

    // 3. User Profiles (PII Isolated to Owner)
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;
      allow create: if isVerifiedUser() && isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming(), userId);
      allow update: if isVerifiedUser() && isOwner(userId) && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().userId == existing().userId
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'email',
          'geminiApiKey',
          'watchlist',
          'priceAlerts',
          'useThb',
          'notificationsEnabled',
          'psychologySettings',
          'updatedAt'
        ]);
      allow delete: if false;
    }

    // 4. User History
    match /users/{userId}/history/{historyId} {
      allow get: if isOwner(userId) && isValidId(userId) && isValidId(historyId);
      allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
      allow create: if isVerifiedUser() && isOwner(userId) && isValidId(userId) && isValidId(historyId)
        && isValidHistoryItem(incoming(), userId, historyId);
      allow update: if false;
      allow delete: if isOwner(userId) && isValidId(userId) && isValidId(historyId);
    }

    // 5. Internal 1,000-Day Historical Candle Archives (Per User)
    match /users/{userId}/assetHistories/{assetId} {
      allow get: if isOwner(userId) && isValidId(userId) && isValidId(assetId);
      allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
      allow create: if isVerifiedUser() && isOwner(userId) && isValidId(userId) && isValidId(assetId)
        && isValidAssetCandleArchive(incoming(), userId, assetId);
      allow update: if isVerifiedUser() && isOwner(userId) && isValidId(userId) && isValidId(assetId)
        && isValidAssetCandleArchive(incoming(), userId, assetId)
        && incoming().userId == existing().userId
        && incoming().assetId == existing().assetId
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'symbol',
          'assetClass',
          'source',
          'candleCount',
          'startDate',
          'endDate',
          'lastRotatedDateKey',
          'candles',
          'updatedAt'
        ]);
      allow delete: if isOwner(userId) && isValidId(userId) && isValidId(assetId);
    }

    // 6. Daily Market & Sensitivity Archives (Per User)
    match /users/{userId}/marketArchives/{dateKey} {
      allow get: if isOwner(userId) && isValidId(userId) && isValidId(dateKey);
      allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
      allow create: if isVerifiedUser() && isOwner(userId) && isValidId(userId) && isValidId(dateKey)
        && isValidMarketArchiveSnapshot(incoming(), userId, dateKey);
      allow update: if isVerifiedUser() && isOwner(userId) && isValidId(userId) && isValidId(dateKey)
        && isValidMarketArchiveSnapshot(incoming(), userId, dateKey)
        && incoming().userId == existing().userId
        && incoming().dateKey == existing().dateKey
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'assetCount',
          'newsCount',
          'rotatedAssetSymbol',
          'perAssetSummary',
          'updatedAt'
        ]);
      allow delete: if isOwner(userId) && isValidId(userId) && isValidId(dateKey);
    }

    // 7. Backtest Anomaly Archives (Per User)
    match /users/{userId}/backtestArchives/{archiveId} {
      allow get: if isOwner(userId) && isValidId(userId) && isValidId(archiveId);
      allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
      allow create: if isVerifiedUser() && isOwner(userId) && isValidId(userId) && isValidId(archiveId)
        && isValidBacktestArchive(incoming(), userId, archiveId);
      allow update: if false;
      allow delete: if isOwner(userId) && isValidId(userId) && isValidId(archiveId);
    }
  }
}
